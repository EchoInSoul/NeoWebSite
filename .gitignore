# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch（与 backend/.gitignore 同款：放临时脚本）
.scratch/
.zcode/

# superpowers 技能的工作区（台账 / 临时件），本机原有 .git/info/exclude 忽略，这里一并入库
.superpowers/

# 运行时数据（媒体文件），见 backend/README.md「媒体存储」
/data/
