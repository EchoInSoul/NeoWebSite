DATABASE_URL=postgresql://neoblog:neoblog@127.0.0.1:5434/neoblog?sslmode=disable
DATABASE_URL_TEST=postgresql://neoblog:neoblog@127.0.0.1:5434/neoblog_test?sslmode=disable
POSTGRES_PASSWORD=neoblog
# 改密码要同时改 POSTGRES_PASSWORD 与两条 DATABASE_URL（compose 与后端读同一个 .env）。
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m

# 邮件（SMTP）。不配置 SMTP_HOST 时邮件只写日志，不影响启动。
# 腾讯云 SES：smtp.qcloudmail.com，465 隐式 TLS（SMTP_TLS=ssl）或 587 STARTTLS
# SMTP_HOST=smtp.qcloudmail.com
# SMTP_PORT=465
# SMTP_TLS=ssl
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=NeoBlog
# 阿里云邮件推送对照：smtpdm.aliyun.com，465（SSL）或 80（STARTTLS）
# 真实投递测试用：非空且 SMTP_* 齐备时，测试会真发一封 example 邮件过去
# MAIL_TEST_RECIPIENT=
